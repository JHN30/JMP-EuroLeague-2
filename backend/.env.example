PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Which database the API reads: "neon" (default, and what Render uses) or "local" (your own Postgres copy for development)
DB_TARGET=neon
# Neon, used when DB_TARGET is "neon" or not set
DB_URL=postgresql://user:password@host/database?sslmode=require
# Local Postgres, used when DB_TARGET is "local"
LOCAL_DB_URL=postgresql://postgres:password@localhost:5432/database
# Optional: the local schema that holds the app_* tables (default gold)
# LOCAL_DB_SCHEMA=gold
